# Application
NODE_ENV=development
PORT=5000
# Add a frontend origin only when it is hosted separately.
# FRONTEND_URL=https://your-frontend.example.com

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=limitless_fitness

# Authentication
# Generate a long random value. Never commit the real secret.
JWT_SECRET=replace_with_a_long_random_secret

# AI provider configuration
PRIMARY_AI=groq
GROQ_API_KEY=
CLAUDE_API_KEY=
# Windows normally uses python; many Linux hosts use python3.
PYTHON_BIN=python

# Razorpay test/live credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional email configuration (backend/utils/email.js)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
